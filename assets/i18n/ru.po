msgstr "Цветной"

#: src/ui/settings.rs:879
msgctxt "tray icon"
msgid "White"
msgstr "Белый"

#: src/ui/settings.rs:880
msgctxt "tray icon"
msgid "Black"
msgstr "Чёрный"

