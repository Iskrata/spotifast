msgstr "Хранилище"

#: src/ui/settings.rs:2081
msgid "Artwork cache"
msgstr "Кэш обложек"

#. Translators: {folder} is the path of a cache folder.
#: src/ui/settings.rs:2083 src/ui/settings.rs:2089
#, rust-format
