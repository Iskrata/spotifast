msgstr "Hareketli albüm kapağı arka planı"

#: src/ui/settings.rs:797
msgid "Reduce motion"
msgstr "Hareketi azalt"

#: src/ui/settings.rs:798
msgid "Reduce transparency"
msgstr "Saydamlığı azalt"

#: src/ui/settings.rs:799
msgid "Compact library sidebar"
msgstr "Kompakt kitaplık kenar çubuğu"

